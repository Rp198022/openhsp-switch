#---------------------------------------------------------------------------------
# OpenHSP -> Nintendo Switch
#
#	T2.2 : interpreter core + empty (console) backend   -> hsp3switch.nro
#	T2.3 : interpreter core + SDL2/GLES graphics backend -> hsp3dish.nro
#
#	Build:   make -f makefile.switch -j$(nproc)          (console, T2.2)
#	         make -f makefile.switch dish -j$(nproc)     (graphics, T2.3)
#
#	Both targets share the interpreter core.  They differ in the backend and in
#	the set of Linux-only translation units that cannot compile on the Switch
#	(libgpiod, libffi, BSD socket command set, libcurl); the missing symbols are
#	supplied by src/hsp3/switch/glue_switch.cpp (shared) and by the
#	src/hsp3dish/switch/ files (graphics target only).
#
#	Upstream source is not modified by either target.  In particular the
#	graphical backend compiles src/hsp3dish/emscripten/*.cpp completely
#	unchanged: the fixed-function GL API they use is provided by a shadowing
#	compatibility header set under src/hsp3dish/switch/glcompat, which is put
#	first on the include path (see glcompat/GL/gl.h for the full rationale).
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

DEVKITA64 ?= $(DEVKITPRO)/devkitA64
PORTLIBS  := $(DEVKITPRO)/portlibs/switch
LIBNX     := $(DEVKITPRO)/libnx
TOOLS     := $(DEVKITPRO)/tools/bin
PREFIX    := $(DEVKITA64)/bin/aarch64-none-elf-

CC        := $(PREFIX)gcc
CXX       := $(PREFIX)g++
LD        := $(PREFIX)g++
NACPTOOL  := $(TOOLS)/nacptool
ELF2NRO   := $(TOOLS)/elf2nro

APP_AUTHOR  := elona-switch-port
APP_VERSION := 1.0.0

ARCH      := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE

#---------------------------------------------------------------------------------
# T2.2 console target
#---------------------------------------------------------------------------------
TARGET      := hsp3switch
APP_TITLE   := OpenHSP switch

DEFINES     := -DHSPLINUX -DHSPDEBUG -DHSP_COM_UNSUPPORTED -DHSP64 -D__SWITCH__
INCLUDE     := -I$(LIBNX)/include -I$(PORTLIBS)/include \
               -Isrc/hsp3 -Isrc/hsp3/linux -Isrc/hsp3dish

CFLAGS      := $(ARCH) $(DEFINES) $(INCLUDE) -O2 -Wno-write-strings \
               -ffunction-sections -fdata-sections
CXXFLAGS    := $(CFLAGS) --exec-charset=UTF-8

LIBDIRS     := -L$(PORTLIBS)/lib -L$(LIBNX)/lib

LDFLAGS     := -specs=$(LIBNX)/switch.specs -g $(ARCH) $(LIBDIRS) \
               -Wl,-Map,$(TARGET).map -Wl,--gc-sections
LIBS        := -lnx -lm

#---------------------------------------------------------------------------------
# T2.3 graphics target
#---------------------------------------------------------------------------------
TARGET_DISH := hsp3dish
APP_TITLE_DISH := OpenHSP dish

#	-DHSPDISH selects the hsp3dish command set (hsp3gr.h / hspwnd.h dispatch,
#	HSPSTAT_DISH) and enables the switch_input.cpp hook in glue_switch.cpp.
DEFINES_DISH := $(DEFINES) -DHSPDISH

#	glcompat MUST come before $(PORTLIBS)/include: it shadows <GL/gl.h> and
#	"SDL2/SDL_opengl.h" so the upstream SDL2 backend compiles against the
#	GLES1-on-GLES2 shim instead of a desktop GL header that does not exist here.
INCLUDE_DISH := -Isrc/hsp3dish/switch/glcompat \
                -I$(LIBNX)/include -I$(PORTLIBS)/include \
                -Isrc/hsp3 -Isrc/hsp3/linux -Isrc/hsp3dish

CFLAGS_DISH   := $(ARCH) $(DEFINES_DISH) $(INCLUDE_DISH) -O2 -Wno-write-strings \
                 -ffunction-sections -fdata-sections
CXXFLAGS_DISH := $(CFLAGS_DISH) --exec-charset=UTF-8

LDFLAGS_DISH  := -specs=$(LIBNX)/switch.specs -g $(ARCH) $(LIBDIRS) \
                 -Wl,-Map,$(TARGET_DISH).map -Wl,--gc-sections

#	SDL2's static Switch build binds EGL/GLES through libglapi
#	(SDL_VIDEO_STATIC_ANGLE), so those libraries must follow it on the link
#	line - same ordering the verified R11 probe uses.  The shim resolves its own
#	GL entry points through SDL_GL_GetProcAddress, so no GLES library needs to
#	be named for it.
SDL_CFLAGS := $(shell $(PREFIX)pkg-config --cflags sdl2 SDL2_image SDL2_mixer SDL2_ttf 2>/dev/null)
SDL_LIBS   := $(shell $(PREFIX)pkg-config --libs sdl2 SDL2_image SDL2_mixer SDL2_ttf 2>/dev/null)

LIBS_DISH := $(SDL_LIBS) -lEGL -lglapi -ldrm_nouveau -lnx -lm

#---------------------------------------------------------------------------------
# object lists
#
#	T2.2 (.swo): interpreter core + the Linux console backend, minus the three
#	translation units that cannot compile on the Switch, plus the two Switch
#	files that replace them.
#---------------------------------------------------------------------------------
OBJS := \
	src/hsp3/dpmread.swo \
	src/hsp3/filepack.swo \
	src/hsp3/hsp3.swo \
	src/hsp3/hsp3code.swo \
	src/hsp3/hsp3crypt.swo \
	src/hsp3/hsp3debug.swo \
	src/hsp3/hsp3int.swo \
	src/hsp3/hsp3utfcnv.swo \
	src/hsp3/hspvar_core.swo \
	src/hsp3/hspvar_double.swo \
	src/hsp3/hspvar_int.swo \
	src/hsp3/hspvar_label.swo \
	src/hsp3/hspvar_str.swo \
	src/hsp3/hspvar_struct.swo \
	src/hsp3/stack.swo \
	src/hsp3/strbuf.swo \
	src/hsp3/strnote.swo \
	src/hsp3/linux/supio_linux.swo \
	src/hsp3/linux/hsp3cl.swo \
	src/hsp3/linux/hsp3gr_linux.swo \
	src/hsp3/linux/hsp3ext_linux.swo \
	src/hsp3/switch/glue_switch.swo \
	src/hsp3/switch/main_switch.swo

#---------------------------------------------------------------------------------
#	T2.3 (.swd): interpreter core + the SDL2/GLES backends from
#	src/hsp3dish/{,emscripten,linux}, minus the four Linux-only units
#	(hsp3ext_sock, devctrl_io, hsp3extlib_ffi, webtask_linux) and the
#	command-line front end, plus the Switch-side replacements.
#
#	OBAQ (the 2D physics add-on) is deliberately left out: it is only pulled in
#	by -DUSE_OBAQ, which this target does not define.
#---------------------------------------------------------------------------------
OBJS_DISH := \
	src/hsp3/dpmread.swd \
	src/hsp3/filepack.swd \
	src/hsp3/hsp3.swd \
	src/hsp3/hsp3code.swd \
	src/hsp3/hsp3crypt.swd \
	src/hsp3/hsp3debug.swd \
	src/hsp3/hsp3int.swd \
	src/hsp3/hsp3utfcnv.swd \
	src/hsp3/hspvar_core.swd \
	src/hsp3/hspvar_double.swd \
	src/hsp3/hspvar_int.swd \
	src/hsp3/hspvar_label.swd \
	src/hsp3/hspvar_str.swd \
	src/hsp3/hspvar_struct.swd \
	src/hsp3/stack.swd \
	src/hsp3/strbuf.swd \
	src/hsp3/strnote.swd \
	src/hsp3/linux/supio_linux.swd \
	src/hsp3/linux/hsp3ext_linux.swd \
	src/hsp3dish/geometry.swd \
	src/hsp3dish/hsp3gr_dish.swd \
	src/hsp3dish/hspwnd_dish.swd \
	src/hsp3dish/hspwnd_obj.swd \
	src/hsp3dish/hspwnd_edit.swd \
	src/hsp3dish/random.swd \
	src/hsp3dish/essprite.swd \
	src/hsp3dish/texmes.swd \
	src/hsp3dish/sysreq.swd \
	src/hsp3dish/emscripten/hgtex.swd \
	src/hsp3dish/emscripten/hgiox.swd \
	src/hsp3dish/emscripten/mmman.swd \
	src/hsp3dish/emscripten/stb_image.swd \
	src/hsp3dish/emscripten/fontsystem.swd \
	src/hsp3dish/linux/hsp3dish.swd \
	src/hsp3/switch/glue_switch.swd \
	src/hsp3dish/switch/gles1_shim.swd \
	src/hsp3dish/switch/switch_input.swd \
	src/hsp3dish/switch/webtask_switch.swd \
	src/hsp3dish/switch/main_dish.swd

#---------------------------------------------------------------------------------

.PHONY: all dish clean

all: $(TARGET).nro

dish: $(TARGET_DISH).nro

$(TARGET).elf: $(OBJS)
	@echo linking ... $@
	@$(LD) $(LDFLAGS) $(OBJS) $(LIBS) -o $@

$(TARGET).nacp:
	@echo creating ... $@
	@$(NACPTOOL) --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TARGET).nro: $(TARGET).elf $(TARGET).nacp
	@echo creating ... $@
	@$(ELF2NRO) $(TARGET).elf $@ --nacp=$(TARGET).nacp

$(TARGET_DISH).elf: $(OBJS_DISH)
	@echo linking ... $@
	@$(LD) $(LDFLAGS_DISH) $(OBJS_DISH) $(LIBS_DISH) -o $@

$(TARGET_DISH).nacp:
	@echo creating ... $@
	@$(NACPTOOL) --create "$(APP_TITLE_DISH)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TARGET_DISH).nro: $(TARGET_DISH).elf $(TARGET_DISH).nacp
	@echo creating ... $@
	@$(ELF2NRO) $(TARGET_DISH).elf $@ --nacp=$(TARGET_DISH).nacp

#	console target objects
%.swo: %.cpp
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

%.swo: %.c
	@echo $(notdir $<)
	@$(CC) $(CFLAGS) -c $< -o $@

#	graphics target objects
%.swd: %.cpp
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS_DISH) -c $< -o $@

%.swd: %.c
	@echo $(notdir $<)
	@$(CC) $(CFLAGS_DISH) -c $< -o $@

clean:
	@echo clean ...
	@rm -f $(OBJS) $(OBJS_DISH) \
		$(TARGET).elf $(TARGET).nro $(TARGET).nacp $(TARGET).map \
		$(TARGET_DISH).elf $(TARGET_DISH).nro $(TARGET_DISH).nacp $(TARGET_DISH).map