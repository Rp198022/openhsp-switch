#---------------------------------------------------------------------------------
# OpenHSP -> Nintendo Switch
#	T2.2 : interpreter core + empty (console) backend
#
#	Build:   make -f makefile.switch -j$(nproc)
#	Output:  hsp3switch.nro
#
#	The object set below is the same one the Linux "hsp3cl" target uses, minus the
#	three translation units that cannot compile on the Switch (libgpiod, libffi,
#	BSD socket command set) and minus the Linux command-line front end.  The
#	missing symbols are supplied by src/hsp3/switch/glue_switch.cpp, and the entry
#	point by src/hsp3/switch/main_switch.cpp.  No upstream file is modified.
#
#	The graphical "hsp3dish" backend (SDL2 + OpenGL/EGL) is deliberately NOT part
#	of this target: it is T2.3 work, and it is what risk R11 is about.
#---------------------------------------------------------------------------------
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

DEVKITA64 ?= $(DEVKITPRO)/devkitA64
PORTLIBS  := $(DEVKITPRO)/portlibs/switch
LIBNX     := $(DEVKITPRO)/libnx
TOOLS     := $(DEVKITPRO)/tools/bin
PREFIX    := $(DEVKITA64)/bin/aarch64-none-elf-

CC        := $(PREFIX)gcc
CXX       := $(PREFIX)g++
LD        := $(PREFIX)g++
NACPTOOL  := $(TOOLS)/nacptool
ELF2NRO   := $(DEVKITA64)/bin/elf2nro

TARGET      := hsp3switch
APP_TITLE   := OpenHSP switch
APP_AUTHOR  := elona-switch-port
APP_VERSION := 1.0.0

ARCH      := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
DEFINES   := -DHSPLINUX -DHSPDEBUG -DHSP_COM_UNSUPPORTED -DHSP64 -D__SWITCH__
INCLUDE   := -I$(LIBNX)/include -I$(PORTLIBS)/include \
             -Isrc/hsp3 -Isrc/hsp3/linux -Isrc/hsp3dish

CFLAGS    := $(ARCH) $(DEFINES) $(INCLUDE) -O2 -Wno-write-strings \
             -ffunction-sections -fdata-sections
CXXFLAGS  := $(CFLAGS) --exec-charset=UTF-8

LDFLAGS   := -specs=$(LIBNX)/switch.specs -g $(ARCH) \
             -Wl,-Map,$(TARGET).map -Wl,--gc-sections
LIBS      := -lnx -lm

#---------------------------------------------------------------------------------
# interpreter core (platform independent - not modified)
#---------------------------------------------------------------------------------
OBJS := \
	src/hsp3/dpmread.swo \
	src/hsp3/filepack.swo \
	src/hsp3/hsp3.swo \
	src/hsp3/hsp3code.swo \
	src/hsp3/hsp3crypt.swo \
	src/hsp3/hsp3debug.swo \
	src/hsp3/hsp3int.swo \
	src/hsp3/hsp3utfcnv.swo \
	src/hsp3/hspvar_core.swo \
	src/hsp3/hspvar_double.swo \
	src/hsp3/hspvar_int.swo \
	src/hsp3/hspvar_label.swo \
	src/hsp3/hspvar_str.swo \
	src/hsp3/hspvar_struct.swo \
	src/hsp3/stack.swo \
	src/hsp3/strbuf.swo \
	src/hsp3/strnote.swo

#---------------------------------------------------------------------------------
# platform layer: POSIX supio + console (CL) backend, both reused from the Linux
# target; plus the two Switch-specific files that replace the Linux-only ones
#---------------------------------------------------------------------------------
OBJS += \
	src/hsp3/linux/supio_linux.swo \
	src/hsp3/linux/hsp3cl.swo \
	src/hsp3/linux/hsp3gr_linux.swo \
	src/hsp3/linux/hsp3ext_linux.swo \
	src/hsp3/switch/glue_switch.swo \
	src/hsp3/switch/main_switch.swo

#---------------------------------------------------------------------------------

.PHONY: all clean

all: $(TARGET).nro

$(TARGET).elf: $(OBJS)
	@echo linking ... $(TARGET).elf
	@$(LD) $(LDFLAGS) $(OBJS) $(LIBS) -o $@

$(TARGET).nacp:
	@echo creating ... $(TARGET).nacp
	@$(NACPTOOL) --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TARGET).nro: $(TARGET).elf $(TARGET).nacp
	@echo creating ... $(TARGET).nro
	@$(ELF2NRO) $(TARGET).elf $@ --nacp=$(TARGET).nacp

%.swo: %.cpp
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

%.swo: %.c
	@echo $(notdir $<)
	@$(CC) $(CFLAGS) -c $< -o $@

clean:
	@echo clean ...
	@rm -f $(OBJS) $(TARGET).elf $(TARGET).nro $(TARGET).nacp $(TARGET).map